name: Deploy to GitHub Pages
on:
  push:
    branches: [main]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: pages
  cancel-in-progress: true
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: .
      - id: deployment
        uses: actions/deploy-pages@v4

:root{--bg:#f4f0e6;--tx:#0a1f21;--mu:#3d5457;--hd:#06292c;--gl:rgba(255,255,255,.82);--ga:rgba(255,255,255,.92);--gz:rgba(250,244,230,.8);--gb:rgba(255,255,255,.85);--ln:rgba(0,60,66,.16);--ac:#006870;--on:#fff;--gd:#b18d44;--ok:#0d7f6c;--wn:#8a6420;--er:#b4382a;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#031416;--tx:#f2f7f5;--mu:#b6cac8;--hd:#f6ecd2;--gl:rgba(8,40,43,.78);--ga:rgba(14,58,62,.8);--gz:rgba(6,32,35,.86);--gb:rgba(255,255,255,.16);--ln:rgba(255,255,255,.14);--ac:#3fb0b6;--on:#04191b;--gd:#d4ae62;--ok:#4fd1b8;--wn:#d9b46a;--er:#ff8f7e}}
:root[data-theme="dark"]{--bg:#031416;--tx:#f2f7f5;--mu:#b6cac8;--hd:#f6ecd2;--gl:rgba(8,40,43,.78);--ga:rgba(14,58,62,.8);--gz:rgba(6,32,35,.86);--gb:rgba(255,255,255,.16);--ln:rgba(255,255,255,.14);--ac:#3fb0b6;--on:#04191b;--gd:#d4ae62;--ok:#4fd1b8;--wn:#d9b46a;--er:#ff8f7e}
html{scroll-behavior:smooth;scroll-padding-top:90px;height:auto}
*{box-sizing:border-box;margin:0;font-family:'Tajawal',system-ui,sans-serif}
body{background:var(--bg);color:var(--tx);line-height:1.7;overflow-x:hidden}
.blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.75;z-index:-1}
nav{position:fixed;top:calc(env(safe-area-inset-top,0px) + 12px);left:50%;transform:translateX(-50%);z-index:20;max-width:calc(100% - 20px);display:flex;gap:4px;padding:6px;border-radius:999px;background:var(--gl);backdrop-filter:blur(28px) saturate(180%);-webkit-backdrop-filter:blur(28px) saturate(180%);border:1px solid var(--gb);box-shadow:0 8px 32px rgba(0,0,0,.12);overflow-x:auto;scrollbar-width:none}
nav a{color:var(--tx);text-decoration:none;font-size:.9rem;font-weight:500;padding:7px 16px;border-radius:999px;white-space:nowrap;transition:background .25s,color .25s}
nav a:hover{background:var(--ln)}
nav a.on{background:var(--tx);color:var(--bg)}
nav a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
section{max-width:1080px;margin:0 auto;padding:96px 20px 40px;position:relative}
.hero{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding-top:120px}
.hero h1{color:var(--hd);font-size:clamp(2.6rem,8vw,5.6rem);font-weight:800;line-height:1.1;letter-spacing:-.02em;max-width:900px}
.hero p{font-size:clamp(1.05rem,2.4vw,1.4rem);color:var(--mu);max-width:640px;margin:22px 0 30px}
.cta{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
.btn{border:0;cursor:pointer;font-size:1rem;font-weight:700;padding:12px 26px;border-radius:999px;background:var(--ac);color:var(--on);text-decoration:none;transition:transform .2s}
.btn:hover{transform:scale(1.04)}
.btn.sec{background:var(--gl);color:var(--tx);border:1px solid var(--gb);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:56px;width:100%;max-width:760px}
.glass{background:linear-gradient(160deg,var(--ga),var(--gz));backdrop-filter:blur(24px) saturate(160%);-webkit-backdrop-filter:blur(24px) saturate(160%);border:1px solid var(--gb);border-radius:26px;padding:22px}
.stat b{display:block;font-size:1.9rem;font-weight:800;color:var(--ac)}
.stat span{color:var(--mu);font-size:.85rem}
h2{color:var(--hd);font-size:clamp(1.9rem,5vw,3rem);font-weight:800;letter-spacing:-.01em;line-height:1.2}
.lead{color:var(--mu);font-size:1.1rem;max-width:620px;margin:10px 0 32px}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
.glass h3{font-size:1.1rem;margin-bottom:10px}
.glass li{margin-bottom:5px;list-style:none;font-size:.95rem}
.m{direction:ltr;unicode-bidi:isolate;display:inline-block;font-family:ui-monospace,Menlo,monospace;font-size:.9rem}
.sim{display:grid;grid-template-columns:1fr 330px;gap:16px;align-items:start}
@media(max-width:880px){.sim{grid-template-columns:1fr}}
.cv{background:#041f22;border-radius:26px;overflow:hidden;border:1px solid var(--ln)}
canvas{width:100%;display:block;cursor:pointer;aspect-ratio:600/420}
.tb{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;color:#c5d8d6;font-size:.82rem;background:rgba(255,255,255,.05)}
.tb button{background:transparent;color:#eef4f2;border:1px solid rgba(255,255,255,.2);border-radius:999px;padding:4px 14px;cursor:pointer}
.side{display:flex;flex-direction:column;gap:12px}
.sb{display:flex;justify-content:space-between;width:100%;align-items:center;background:var(--gl);border:1px solid var(--ln);color:var(--tx);padding:11px 16px;border-radius:16px;margin-bottom:8px;cursor:pointer;font-size:.95rem;transition:all .25s}
.sb.on{border-color:var(--ac);box-shadow:0 0 0 3px color-mix(in srgb,var(--ac) 22%,transparent)}
.row{display:flex;gap:8px}.row .btn{flex:1;padding:10px;font-size:.9rem}
.bar{height:8px;border-radius:9px;background:var(--ln);overflow:hidden;margin:6px 0 14px}
.bar i{display:block;height:100%;width:0;background:var(--er);transition:width .4s,background .4s}
.kv{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:.92rem}
.bd{padding:3px 12px;border-radius:999px;font-weight:700;font-size:.78rem;background:var(--ln)}
.ok{color:var(--ok)}.wn{color:var(--wn)}.er{color:var(--er)}
.al{margin-top:8px;font-size:.82rem;color:var(--wn)}
.cl li{display:flex;justify-content:space-between;padding:6px 10px;border-radius:10px;background:var(--ln);font-size:.85rem}
table{width:100%;border-collapse:collapse;font-size:.92rem;text-align:center}
th,td{padding:10px 8px;border-bottom:1px solid var(--ln)}
th{color:var(--mu);font-weight:500}
tr.best td{background:color-mix(in srgb,var(--ok) 16%,transparent);font-weight:700}
.tw{overflow-x:auto}
.sl{display:grid;grid-template-columns:1fr;gap:14px}
.sl label{display:flex;justify-content:space-between;font-size:.92rem;font-weight:500}
input[type=range]{width:100%;accent-color:var(--ac);direction:ltr}
.steps li{margin-bottom:8px}
footer{text-align:center;color:var(--mu);padding:60px 20px 80px;font-size:.9rem}
/* ===== خلفية زجاجية متحركة ===== */
:root{--o1:rgba(0,104,112,.13);--o2:rgba(177,141,68,.12);--o3:rgba(0,140,148,.07);--solid:color-mix(in srgb,var(--tx) 6%,var(--bg))}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--o1:rgba(0,128,138,.22);--o2:rgba(177,141,68,.11);--o3:rgba(0,104,112,.24)}}
:root[data-theme="dark"]{--o1:rgba(0,128,138,.22);--o2:rgba(177,141,68,.11);--o3:rgba(0,104,112,.24)}
.bg{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.bg i{position:absolute;width:75vmax;height:75vmax;border-radius:50%;background:radial-gradient(circle,var(--c) 0,transparent 62%);will-change:transform,opacity}
.bg i:nth-child(1){--c:var(--o1);top:-25vmax;right:-20vmax;animation:d1 47s ease-in-out infinite alternate,p1 29s ease-in-out infinite alternate}
.bg i:nth-child(2){--c:var(--o2);bottom:-30vmax;left:-25vmax;animation:d2 61s ease-in-out infinite alternate,p2 37s ease-in-out infinite alternate}
.bg i:nth-child(3){--c:var(--o3);top:20vh;left:25vw;width:55vmax;height:55vmax;animation:d3 73s ease-in-out infinite alternate,p3 41s ease-in-out infinite alternate}
@keyframes d1{0%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(-22%,18%,0) scale(1.2)}100%{transform:translate3d(-8%,45%,0) scale(.9)}}
@keyframes d2{0%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(30%,-20%,0) scale(1.15)}100%{transform:translate3d(12%,-45%,0) scale(1.3)}}
@keyframes d3{0%{transform:translate3d(-20%,10%,0) scale(.9)}50%{transform:translate3d(25%,-15%,0) scale(1.25)}100%{transform:translate3d(5%,25%,0) scale(1)}}
@keyframes p1{0%{opacity:.55}100%{opacity:1}}@keyframes p2{0%{opacity:1}100%{opacity:.5}}@keyframes p3{0%{opacity:.4}100%{opacity:.95}}
.glass{position:relative;box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 14px 44px rgba(0,25,28,.22)}
.glass::before{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(135deg,rgba(255,255,255,.28),transparent 38%);opacity:.3;pointer-events:none}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.glass,nav,.btn.sec{background:var(--solid)}}
/* ===== كشف تدريجي عند التمرير ===== */
.rv{opacity:0;transform:translateY(28px);transition:opacity .9s cubic-bezier(.16,1,.3,1) var(--d,0ms),transform .9s cubic-bezier(.16,1,.3,1) var(--d,0ms)}
.rv.sc{transform:translateY(16px) scale(.96)}
.rv.is{opacity:1;transform:none}
.rv:not(.is){transition-duration:.3s,.3s;transition-delay:0s}
/* ===== شاشة المقدمة ===== */
#intro{display:none}
.intro #intro{display:grid;position:fixed;inset:0;z-index:100;place-items:center;background:radial-gradient(120% 90% at 50% 40%,color-mix(in srgb,var(--ac) 10%,var(--bg)),var(--bg));transition:opacity .9s ease .1s}
.intro body{overflow:hidden}
#intro .lg{position:relative;opacity:0;transform:scale(.92);transition:opacity 1.1s cubic-bezier(.16,1,.3,1),transform 1.4s cubic-bezier(.16,1,.3,1)}
#intro .lg img{display:block;width:min(56vw,260px);height:auto}
#intro .lg::before{content:"";position:absolute;inset:-60%;z-index:-1;background:radial-gradient(closest-side,color-mix(in srgb,var(--gd) 26%,transparent),transparent);opacity:0;transition:opacity 1.6s ease}
#intro.in .lg{opacity:1;transform:none}
#intro.in .lg::before{opacity:1}
#intro.out{opacity:0;pointer-events:none}
#intro.out .lg{opacity:0;transform:scale(1.06);transition-duration:.8s}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}.bg i{animation:none!important}}

const $=id=>document.getElementById(id);
const sub=['₁','₂','₃'];
const S=[{n:'S1',x:170,y:210,cost:1000,col:'#d4ae62',on:0},{n:'S2',x:400,y:230,cost:1200,col:'#2fb3b9',on:0},{n:'S3',x:200,y:330,cost:800,col:'#c9ebe6',on:0}];
const B=[{k:'A',x:100,y:300},{k:'B',x:290,y:190},{k:'C',x:480,y:130},{k:'D',x:300,y:330}];
let R=150,showD=true,tick=0;
const dist=(s,b)=>Math.hypot(s.x-b.x,s.y-b.y);
const cov=(s,b,r=R)=>dist(s,b)<=r;
const fmt=n=>n.toLocaleString('en-US');
function solve(r=R){const rows=[];for(let m=0;m<8;m++){const on=S.map((_,i)=>m>>i&1);const cost=S.reduce((a,s,i)=>a+on[i]*s.cost,0);const c=B.filter(b=>S.some((s,i)=>on[i]&&cov(s,b,r))).length;rows.push({on,cost,c,f:c==B.length})}
const f=rows.filter(x=>x.f);const sm=x=>x.on.reduce((a,b)=>a+b,0);
return{rows,best:f.length?f.reduce((a,x)=>x.cost<a.cost||(x.cost==a.cost&&sm(x)<sm(a))?x:a):null}}
const names=on=>S.filter((_,i)=>on[i]).map(s=>s.n).join(' + ')||'لا شيء';
const coverers=b=>S.map((s,i)=>cov(s,b)?i:-1).filter(i=>i>=0);

function render(){
const {rows,best}=solve();
// model
$('m-c').textContent='c = ('+S.map(s=>fmt(s.cost)).join(', ')+')';
$('m-z').textContent='min Z = '+S.map((s,i)=>fmt(s.cost)+'x'+sub[i]).join(' + ');
$('m-cons').innerHTML=B.map(b=>{const c=coverers(b);return`<li><b>${b.k}:</b> <span class="m">${c.length?c.map(i=>'x'+sub[i]).join(' + ')+' ≥ 1':'0 ≥ 1 (مستحيل)'}</span></li>`}).join('');
// hero
$('h-z').textContent=best?fmt(best.cost):'لا حل';$('h-s').textContent=best?names(best.on):'–';$('h-r').textContent=R+' م';
$('tb-r').textContent='📍 نصف القطر = '+R+' متراً';
// sim
$('sbs').innerHTML=S.map((s,i)=>`<button class="sb ${s.on?'on':''}" data-i="${i}"><span>الموقع ${i+1} (${s.n})</span><b><i style="display:inline-block;width:10px;height:10px;border-radius:50%;background:${s.col};box-shadow:0 0 0 1px var(--ln);margin-inline-end:8px"></i>${fmt(s.cost)} ر.س</b></button>`).join('');
const z=S.reduce((a,s)=>a+s.on*s.cost,0);
const cv=B.map(b=>S.some(s=>s.on&&cov(s,b)));const n=cv.filter(Boolean).length,pc=n/B.length*100;
$('pc').textContent=pc+'%';$('fl').style.width=pc+'%';$('fl').style.background=pc==100?'var(--ok)':pc?'var(--wn)':'var(--er)';
$('zv').textContent=fmt(z)+' ر.س';
const bd=$('bd'),al=$('al');al.textContent='';
if(n<B.length){bd.textContent='غير ممكن';bd.className='bd er'}
else if(best&&z==best.cost){bd.textContent='الحل الأمثل';bd.className='bd ok'}
else{bd.textContent='ممكن لكن غير أمثل';bd.className='bd wn';al.textContent='هدر مالي: الأمثل هو '+names(best.on)+' بتكلفة '+fmt(best.cost)+' ر.س.'}
$('cl').innerHTML=B.map((b,i)=>`<li><span>المربع ${b.k}</span><span class="${cv[i]?'ok':'er'}">${cv[i]?'✔ محقق':'✖ مكشوف'}</span></li>`).join('');
// solver
const forced=B.filter(b=>coverers(b).length==1);
$('st').innerHTML=(forced.length?forced.map(b=>`<li>المربع ${b.k} يغطيه ${S[coverers(b)[0]].n} فقط، فهو إجباري.</li>`).join(''):'<li>لا يوجد مربع يغطيه موقع واحد فقط.</li>')+
'<li>نفحص الحالات الثماني ونستبعد غير الممكنة.</li>'+(best?`<li>أقل تكلفة بين الممكنة: <b>${names(best.on)} = ${fmt(best.cost)} ر.س</b>.</li>`:'<li class="er">لا توجد حالة تغطي كل المربعات، زد نصف القطر.</li>');
$('tb').innerHTML=rows.map(r=>`<tr class="${r===best?'best':''}"><td><span class="m">${r.on.join(' ')}</span></td><td>${fmt(r.cost)}</td><td>${r.c}/4</td><td class="${r.f?'ok':'er'}">${r===best?'الأمثل ★':r.f?'ممكن':'غير ممكن'}</td></tr>`).join('');
// sensitivity
$('rv').textContent=R+' م';S.forEach((s,i)=>$('c'+(i+1)+'v').textContent=fmt(s.cost)+' ر.س');
let svg='',first=null,mx=0;const pts=[];
for(let r=80;r<=250;r+=5){const b=solve(r).best;pts.push([r,b?b.cost:null]);if(b){mx=Math.max(mx,b.cost);if(first===null)first=r}}
const top=Math.max(mx,1000)*1.15;
pts.forEach(([r,c])=>{const x=20+(r-80)*3.3;if(c===null){svg+=`<rect x="${x}" y="190" width="14" height="4" rx="2" fill="var(--er)" opacity=".5"/>`}else{const h=c/top*170;svg+=`<rect x="${x}" y="${195-h}" width="14" height="${h}" rx="4" fill="${r==R?'var(--ac)':'var(--mu)'}" opacity="${r==R?1:.55}"><title>R=${r}: ${fmt(c)}</title></rect>`}});
[100,150,200,250].forEach(r=>svg+=`<text x="${20+(r-80)*3.3+7}" y="216" text-anchor="middle" font-size="12" fill="var(--mu)">${r}</text>`);
$('ch').innerHTML=svg;
$('ins').textContent=first?`أقل نصف قطر يجعل المسألة ممكنة: ${first} م. الخطوط الحمراء تعني عدم وجود حل.`:'لا يوجد حل في هذا المجال.';
}
// canvas
const cvs=$('cv'),ctx=cvs.getContext('2d');
function frame(){
tick+=.05;ctx.clearRect(0,0,600,420);
ctx.strokeStyle='rgba(255,255,255,.04)';ctx.lineWidth=1;
for(let i=0;i<=600;i+=40){ctx.beginPath();ctx.moveTo(i,0);ctx.lineTo(i,420);ctx.stroke()}
for(let i=0;i<=420;i+=40){ctx.beginPath();ctx.moveTo(0,i);ctx.lineTo(600,i);ctx.stroke()}
S.forEach(s=>{if(!s.on)return;ctx.save();ctx.beginPath();ctx.arc(s.x,s.y,R,0,7);ctx.fillStyle=s.col+'1f';ctx.fill();ctx.setLineDash([6,4]);ctx.lineWidth=2;ctx.strokeStyle=s.col;ctx.stroke();ctx.restore()});
if(showD){ctx.save();ctx.font='bold 11px Tajawal';ctx.textAlign='center';ctx.textBaseline='middle';
S.forEach(s=>{if(!s.on)return;B.forEach(b=>{const d=dist(s,b),ok=d<=R,c=ok?s.col:'#e8806f';
ctx.setLineDash([5,5]);ctx.strokeStyle=c;ctx.globalAlpha=ok?1:.35;ctx.beginPath();ctx.moveTo(s.x,s.y);ctx.lineTo(b.x,b.y);ctx.stroke();
if(ok){const t=.5,mx=s.x+(b.x-s.x)*t,my=s.y+(b.y-s.y)*t;ctx.setLineDash([]);ctx.fillStyle='rgba(5,42,45,.95)';ctx.beginPath();ctx.roundRect(mx-29,my-11,58,22,7);ctx.fill();ctx.stroke();ctx.fillStyle=c;ctx.fillText(Math.round(d)+' م',mx,my+1)}ctx.globalAlpha=1})});ctx.restore()}
B.forEach(b=>{const c=S.some(s=>s.on&&cov(s,b));ctx.save();if(c){ctx.shadowColor='#4fd1c0';ctx.shadowBlur=14}ctx.fillStyle=c?'#4fd1c0':'#3d5f61';ctx.beginPath();ctx.roundRect(b.x-17,b.y-17,34,34,9);ctx.fill();ctx.fillStyle='#fff';ctx.font='bold 13px Tajawal';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(b.k,b.x,b.y+1);ctx.restore()});
S.forEach(s=>{ctx.save();if(s.on){ctx.beginPath();ctx.arc(s.x,s.y,19+Math.sin(tick)*2,0,7);ctx.strokeStyle=s.col+'88';ctx.lineWidth=2;ctx.stroke();ctx.shadowColor=s.col;ctx.shadowBlur=14}
ctx.fillStyle=s.on?s.col:'#3d5f61';ctx.beginPath();ctx.arc(s.x,s.y,14,0,7);ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#fff';ctx.font='bold 11px Tajawal';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(s.n,s.x,s.y+1);ctx.restore()});
requestAnimationFrame(frame)}
// events
const tog=i=>{S[i].on^=1;render()};
cvs.onclick=e=>{const r=cvs.getBoundingClientRect(),x=(e.clientX-r.left)*600/r.width,y=(e.clientY-r.top)*420/r.height;const i=S.findIndex(s=>Math.hypot(s.x-x,s.y-y)<24);if(i>=0)tog(i)};
$('sbs').onclick=e=>{const b=e.target.closest('.sb');if(b)tog(+b.dataset.i)};
$('rs').onclick=()=>{S.forEach(s=>s.on=0);render()};
$('opt').onclick=()=>{const b=solve().best;if(b){S.forEach((s,i)=>s.on=b.on[i]);render()}};
$('tg').onclick=e=>{showD=!showD;e.target.textContent=showD?'إخفاء المسافات':'إظهار المسافات'};
$('rg').oninput=e=>{R=+e.target.value;render()};
[1,2,3].forEach(i=>$('c'+i).oninput=e=>{S[i-1].cost=+e.target.value;render()});
// nav highlight
const links=[...document.querySelectorAll('nav a')],secs=links.map(a=>document.querySelector(a.getAttribute('href')));
addEventListener('scroll',()=>{let k=0;secs.forEach((s,i)=>{if(s.getBoundingClientRect().top<200)k=i});links.forEach((a,i)=>a.classList.toggle('on',i==k))},{passive:true});
// كشف التمرير + شاشة المقدمة
(function(){
const d=document.documentElement,rm=matchMedia('(prefers-reduced-motion:reduce)').matches,it=$('intro');
const els=[...document.querySelectorAll('.hero h1,.hero p,.hero .cta,.stats .glass,section>h2,section>.lead,.grid2>.glass,.cv,.side>.glass,footer')],cnt=new Map();
if(!rm&&'IntersectionObserver' in window)els.forEach(el=>{const p=el.parentElement,i=cnt.get(p)||0;cnt.set(p,i+1);el.style.setProperty('--d',(Math.min(i,5)*90+(el.closest('.stats')?270:0))+'ms');el.classList.add('rv');if(el.matches('.cv,.stats .glass'))el.classList.add('sc')});
let started=0;
function go(){if(started++||rm||!('IntersectionObserver' in window))return;
const io=new IntersectionObserver(es=>es.forEach(e=>{const el=e.target;if(!e.isIntersecting){el.classList.remove('is');return}if(e.intersectionRect.height>=Math.min(90,e.boundingClientRect.height*.5))el.classList.add('is')}),{threshold:[0,.05,.1,.15,.25,.4,.6,1],rootMargin:'0px 0px -6% 0px'});
els.forEach(el=>io.observe(el))}
function finish(){d.classList.remove('intro');if(it)it.remove()}
if(d.classList.contains('intro')&&it){
try{sessionStorage.setItem('uqu-intro','1')}catch(e){}
const img=it.querySelector('img');let ran=0;
const run=()=>{if(ran++)return;requestAnimationFrame(()=>it.classList.add('in'));setTimeout(()=>{it.classList.add('out');go()},rm?1300:2500);setTimeout(finish,rm?1700:3500)};
const dk=d.dataset.theme==='dark'||(d.dataset.theme!=='light'&&matchMedia('(prefers-color-scheme:dark)').matches);img.onload=run;img.onerror=()=>{finish();go()};img.src=dk&&window.UQU_LOGO_W?window.UQU_LOGO_W:window.UQU_LOGO;
it.onclick=()=>{it.classList.add('out');go();setTimeout(finish,500)};
}else{finish();go()}
})();
